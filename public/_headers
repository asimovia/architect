# Portal-specific headers.
#
# The portal is a daemon client. It must NOT be cached aggressively
# (a stale shell against a fresh daemon API is the worst kind of bug
# to diagnose), but should still hit the CF edge for SSL termination
# and global delivery.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# ATM22 — the update signal. `/health.json` is what a running tab polls
# to learn that a newer build is live; an edge-cached copy is a tab that
# never raises the blue "reload" bar. The poll already cache-busts with
# `?t=`, this closes the plain-URL path too.
/health.json
  Cache-Control: no-store

# REL2 — the daemon auto-update surface. Every cluster fetches these two
# files by their plain URL and verifies one against the other; an edge
# copy of either, a deploy out of step, is a release that silently does
# not arrive (observed 2026-09-21: the plain URL served the previous
# bundle while `?t=` served the new one).
/reference/cluster/scripts/daemon.py
  Cache-Control: no-store
/reference/cluster/scripts/daemon.py.sig
  Cache-Control: no-store
